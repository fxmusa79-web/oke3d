/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Provision remote resources (once, after `npx wrangler login`):
 *   npm run cf:provision
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "oke3d",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "CUSTOM_REQUESTS",
			"database_name": "oke3d_requests",
			"database_id": "640ba036-92ce-4b3e-974b-6d960142f58b",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_UPLOADS",
			"bucket_name": "oke3d-uploads"
		}
	]
}
