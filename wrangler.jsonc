/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "okstore",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * D1 + R2 for custom figure requests.
	 * Provision first, then uncomment and paste the real database_id:
	 *   npx wrangler d1 create oke3d_requests
	 *   npx wrangler d1 migrations apply CUSTOM_REQUESTS --remote
	 *   npx wrangler r2 bucket create oke3d-uploads
	 *
	 * "d1_databases": [
	 *   {
	 *     "binding": "CUSTOM_REQUESTS",
	 *     "database_name": "oke3d_requests",
	 *     "database_id": "REPLACE_WITH_D1_ID",
	 *     "migrations_dir": "migrations"
	 *   }
	 * ],
	 * "r2_buckets": [
	 *   {
	 *     "binding": "R2_UPLOADS",
	 *     "bucket_name": "oke3d-uploads"
	 *   }
	 * ]
	 */
}
